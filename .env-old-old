# Agrisense AI environment template
# Copy this file to .env for local use only. Never commit .env or credentials.
# The public demo can run with the Vertex settings below plus safe fallbacks.

AGRISENSE_AI_PROVIDER=vertex
AGRISENSE_REQUIRE_VERTEX=true

GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=asia-south1
AGRISENSE_VERTEX_MODEL=gemini-2.5-flash

WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
AGRISENSE_DEFAULT_LANGUAGE=en

AGRISENSE_EARTH_ENGINE_ENABLED=true
EARTH_ENGINE_DATE_START=2026-06-01
EARTH_ENGINE_DATE_END=2026-09-30
EARTH_ENGINE_MAX_CLOUD_PERCENT=50

AGRISENSE_GCS_BUCKET=agrisense-leaves-506317
AGRISENSE_GCS_SIGNED_URL_MINUTES=30

AGRISENSE_BQ_DATASET=agrisense_telemetry
AGRISENSE_BQ_TABLE=advisory_events

# === Recommended application configuration ===
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
AGRISENSE_DEFAULT_LANGUAGE=en

# === Optional full-stack/auth configuration ===
# Leave empty for the public demo. Configure only for protected/authenticated flows.
DATABASE_URL=
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# === Optional legacy/platform AI gateway variables ===
# Not required when AGRISENSE_AI_PROVIDER=vertex. Do not add OpenAI keys here.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
AGRISENSE_LLM_MODEL=gemini-3-flash-preview

# === Optional branding ===
VITE_APP_TITLE=Agrisense AI
VITE_APP_LOGO=

# === Managed/runtime variables ===
# PORT is supplied by the runtime; do not hardcode it.
# NODE_ENV is set by the package scripts.
# VITE_ANALYTICS_ENDPOINT and VITE_ANALYTICS_WEBSITE_ID are intentionally omitted:
# analytics is optional and the app does not load an analytics script when unset.

# === Optional India-scale Google Cloud adapters ===
# Earth Engine is disabled unless explicitly enabled. The JSON value must be supplied
# locally or through a secret manager; never commit it to source control.
AGRISENSE_EARTH_ENGINE_ENABLED=false
EARTH_ENGINE_SERVICE_ACCOUNT_JSON=
EARTH_ENGINE_DATE_START=2026-07-01
EARTH_ENGINE_DATE_END=2026-08-31
EARTH_ENGINE_MAX_CLOUD_PERCENT=35

# Cloud Storage is disabled when the bucket is empty. Leaf uploads remain ephemeral then.
AGRISENSE_GCS_BUCKET=
AGRISENSE_GCS_SIGNED_URL_MINUTES=30

# BigQuery telemetry is disabled until both dataset and table are supplied.
AGRISENSE_BQ_DATASET=
AGRISENSE_BQ_TABLE=advisory_events
